# Bluescape API Authentication
# OAuth is selected automatically when CLIENT_ID and CLIENT_SECRET are set.
BLUESCAPE_AUTH_MODE=oauth
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
OAUTH_TOKEN_URL=https://api.apps.us.bluescape.com/v3/oauth2/token
OAUTH_AUTHORIZE_URL=https://api.apps.us.bluescape.com/v3/oauth2/authorize
# OAUTH_SCOPE=your_scope_here
# Set BLUESCAPE_AUTH_MODE=jwt and provide JWT_TOKEN to use a JWT instead.
# JWT_TOKEN=your_jwt_token_here

# Bluescape Configuration
BLUESCAPE_API_URL=https://elementary.apps.us.bluescape.com/api/v3
WORKSPACE_ID=your_workspace_id

# Polling Configuration (in seconds)
POLL_INTERVAL=15

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# HTTP Configuration
HTTP_TIMEOUT_MS=10000

# Chat Trigger
# Users invoke AI processing with @<TRIGGER_WORD>, e.g. @llm
TRIGGER_WORD=llm

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=800
AI_MAX_ASSET_BYTES=25000000
AI_CHAT_RESPONSE_MAX_CHARS=3500

# Logging
LOG_LEVEL=info
